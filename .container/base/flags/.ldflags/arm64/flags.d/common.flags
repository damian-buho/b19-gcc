-Wl,--no-as-needed                      # Link all libraries even if not directly referenced
-Wl,-z,now                              # Resolve all symbols immediately at load time
-Wl,-z,relro                            # Enable RELRO (Relocation Read-Only) for security
-fstack-protector-strong                # Enable strong stack protection
-lm                                     # Link with math library
